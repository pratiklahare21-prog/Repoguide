# --- AI (Ollama, runs locally) ---
OLLAMA_HOST=http://127.0.0.1:11434
# 8 GB RAM: qwen2.5:3b or llama3.2:3b | 16 GB RAM: qwen2.5:7b (better quality)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.3

# --- GitHub (optional but recommended: 60 -> 5000 requests/hour) ---
GITHUB_TOKEN=

# --- Server ---
PORT=8787
CORS_ORIGIN=http://localhost:5173
# If live generation fails, serve a saved guide for the same repo
DEMO_FALLBACK=true
